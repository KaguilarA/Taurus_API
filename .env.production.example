NODE_ENV=production
HOST=0.0.0.0
PORT=10000
TRUST_PROXY=1
LOCAL_MONGO_AUTOSTART=false
DB_NAME=your_database
DB_HOST=mongodb+srv://DATABASE_USER:URL_ENCODED_PASSWORD@CLUSTER_HOST/your_database?retryWrites=true&w=majority
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# The public frontend origin, never the backend URL.
FRONTEND_URL=https://YOUR-FRONTEND.pages.dev
# No FRONTEND_DIST: this service serves only the API.
# RESET_USERNAME=admin
# RESET_PASSWORD=YOUR_NEW_UNIQUE_PASSWORD

# Image uploads: backend only. Get this value from the Cloudinary API Keys page.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Optional instead of CLOUDINARY_URL: CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET.
CLOUDINARY_FOLDER=your-business

# The first administrator is registered through /setup, not environment variables.

# Required for Docker HEALTHCHECK; match the configured API port.
HEALTHCHECK_URL=http://127.0.0.1:10000/api/ready
# If several legacy businesses exist, choose the business ID to migrate.
# BUSINESS_ID=
