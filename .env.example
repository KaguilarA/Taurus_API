DB_HOST=mongodb://127.0.0.1:27017/taurus?replicaSet=rs0
DB_NAME=taurus
PORT=4000
HOST=127.0.0.1
TRUST_PROXY=0
FRONTEND_URL=http://localhost:4200
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
# Optional: serve an already-built frontend from this directory in the API process.
# FRONTEND_DIST=./web
# Optional: sibling frontend source used by npm run bundle:production.
FRONTEND_SOURCE_DIR=../taurus-ng-fe

# Optional persistent local instance, separate from an existing MongoDB service.
# Set DB_HOST=mongodb://127.0.0.1:27018/taurus?replicaSet=taurus-local
LOCAL_MONGO_AUTOSTART=false
LOCAL_MONGO_BINARY="C:/Program Files/MongoDB/Server/8.3/bin/mongod.exe"
LOCAL_MONGO_PORT=27018
LOCAL_MONGO_REPLICA_SET=taurus-local
LOCAL_MONGO_DATA_DIR=.local/mongodb

# Image uploads: backend only. Get this value from the Cloudinary API Keys page.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Optional instead of CLOUDINARY_URL: CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET.
CLOUDINARY_FOLDER=your-business

# Required for Docker HEALTHCHECK; match the configured API port.
HEALTHCHECK_URL=http://127.0.0.1:4000/api/ready
# If several legacy businesses exist, choose the business ID to migrate.
# BUSINESS_ID=

# TinyPNG optimization, backend only. Keep the API key private.
TINIFY_API_URL=https://api.tinify.com/shrink
# TINIFY_API_KEY=YOUR_PRIVATE_API_KEY
