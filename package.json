{
  "name": "Taurus-API",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "smoke:production": "node scripts/smoke-production.js",
    "bundle:production": "node scripts/bundle-production.js",
    "account:password": "node scripts/account-password.js",
    "start": "node index.js",
    "dev": "node --watch index.js",
    "db:start": "node db/local-mongo.js",
    "db:stop": "node db/local-mongo.js --stop",
    "test": "node --test --test-concurrency=2 test/integration/*.test.js scripts/*.test.mjs"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@12.0.1",
  "author": {
    "name": "Kevin Aguilar",
    "email": "kevin.231@hotmail.com",
    "url": "https://github.com/KaguilarA"
  },
  "license": "UNLICENSED",
  "private": true,
  "description": "API to manage the Taurus project",
  "dependencies": {
    "cloudinary": "^2.11.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "owl-expressjs-utils": "https://codeload.github.com/KaguilarA/owl-expressjs-utils/tar.gz/4b85d6d84a53c59926870c271fe084f2a7004fb3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "express-session": "^1.19.0",
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
